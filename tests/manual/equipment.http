@endpoint = http://localhost:3000/api/v1/equipment


@existingEquipmentId = 6ac9105fc55f94b913b89731


###
# 1. Create equipment - valid POST
# @name postEquipment
POST {{endpoint}} HTTP/1.1
content-type: application/json
x-api-key: blahblah

{
    "name": "Canon EOS Camera",
    "category": "Camera",
    "description": "Professional digital camera",
    "dailyRate": 50,
    "status": "Available",
    "condition": "Good"
}


###
# Reference the equipment created by the valid POST
@newEquipment = {{postEquipment.response.body._id}}


###
# 2. Create equipment - missing name (invalid POST)
POST {{endpoint}} HTTP/1.1
content-type: application/json
x-api-key: blahblah

{
    "category": "Camera",
    "description": "Professional digital camera",
    "dailyRate": 50,
    "status": "Available",
    "condition": "Good"
}


###
# Additional invalid POST - empty name
POST {{endpoint}} HTTP/1.1
content-type: application/json
x-api-key: blahblah

{
    "name": "",
    "category": "Camera",
    "description": "Professional digital camera",
    "dailyRate": 50,
    "status": "Available",
    "condition": "Good"
}


###
# Additional invalid POST - missing daily rate
POST {{endpoint}} HTTP/1.1
content-type: application/json
x-api-key: blahblah

{
    "name": "Camera Without Rate",
    "category": "Camera",
    "description": "Professional digital camera",
    "status": "Available",
    "condition": "Good"
}


###
# Additional invalid POST - negative daily rate
POST {{endpoint}} HTTP/1.1
content-type: application/json
x-api-key: blahblah

{
    "name": "Camera With Invalid Rate",
    "category": "Camera",
    "description": "Professional digital camera",
    "dailyRate": -10,
    "status": "Available",
    "condition": "Good"
}


###
# Additional invalid POST - daily rate has the wrong type
