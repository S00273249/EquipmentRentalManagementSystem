@endpoint = http://localhost:3000/api/v1/equipment

###
# Create equipment
# @name postEquipment
POST {{endpoint}} HTTP/1.1
content-type: application/json
x-api-key: blahblah

{
    "name": "Canon EOS Camera",
    "category": "Camera",
    "description": "Professional digital camera",
    "dailyRate": 50,
    "status": "Available",
    "condition": "Good"
}

###
# Missing name
POST {{endpoint}} HTTP/1.1
content-type: application/json
x-api-key: blahblah

{
    "category": "Camera",
    "description": "Professional digital camera",
    "dailyRate": 50,
    "status": "Available",
    "condition": "Good"
}

###
# Empty name
POST {{endpoint}} HTTP/1.1
content-type: application/json
x-api-key: blahblah

{
    "name": "",
    "category": "Camera",
    "description": "Professional digital camera",
    "dailyRate": 50,
    "status": "Available",
    "condition": "Good"
}

###
# Missing daily rate
POST {{endpoint}} HTTP/1.1
content-type: application/json
x-api-key: blahblah

{
    "name": "Canon EOS Camera",
    "category": "Camera",
    "description": "Professional digital camera",
    "status": "Available",
    "condition": "Good"
}

###
# Invalid daily rate
POST {{endpoint}} HTTP/1.1
content-type: application/json
x-api-key: blahblah

{
    "name": "Canon EOS Camera",
    "category": "Camera",
    "description": "Professional digital camera",
    "dailyRate": -10,
    "status": "Available",
    "condition": "Good"
}

###
# Wrong type for daily rate
POST {{endpoint}} HTTP/1.1
content-type: application/json
x-api-key: blahblah

{
    "name": "Canon EOS Camera",
    "category": "Camera",
    "description": "Professional digital camera",
    "dailyRate": "50",
    "status": "Available",
    "condition": "Good"
}

###
@newEquipment = {{postEquipment.response.body._id}}

###
# Get equipment by ID
GET {{endpoint}}/{{newEquipment}} HTTP/1.1
content-type: application/json
x-api-key: blahblah

###
# Get all equipment
GET {{endpoint}} HTTP/1.1
content-type: application/json
x-api-key: blahblah

###
# Valid update - all fields
PUT {{endpoint}}/{{newEquipment}} HTTP/1.1
content-type: application/json
x-api-key: blahblah

{
    "name": "Canon EOS R5",
    "category": "Camera",
    "description": "Professional mirrorless camera",
    "dailyRate": 75,
    "status": "Available",
    "condition": "Excellent"
}

###
# Valid update - name only
PUT {{endpoint}}/{{newEquipment}} HTTP/1.1
content-type: application/json
x-api-key: blahblah

{
    "name": "Canon EOS R6"
}

###
# Valid update - daily rate only
PUT {{endpoint}}/{{newEquipment}} HTTP/1.1
content-type: application/json
x-api-key: blahblah

{
    "dailyRate": 60
}

###
# Invalid update - empty name
PUT {{endpoint}}/{{newEquipment}} HTTP/1.1
content-type: application/json
x-api-key: blahblah

{
    "name": ""
}

###
# Invalid update - negative daily rate
PUT {{endpoint}}/{{newEquipment}} HTTP/1.1
content-type: application/json
x-api-key: blahblah

{
    "dailyRate": -20
}

###
# Invalid update - daily rate is a string
PUT {{endpoint}}/{{newEquipment}} HTTP/1.1
content-type: application/json
x-api-key: blahblah

{
    "dailyRate": "60"
}

###
# Filter equipment by category
GET {{endpoint}}/search?category=Camera HTTP/1.1
x-api-key: blahblah

###
# Filter equipment by status
GET {{endpoint}}/search?status=Available HTTP/1.1
x-api-key: blahblah

###
# Filter equipment by condition
GET {{endpoint}}/search?condition=Good HTTP/1.1
x-api-key: blahblah

###
# Filter equipment by multiple fields
GET {{endpoint}}/search?category=Camera&status=Available HTTP/1.1
x-api-key: blahblah

###
# Sort equipment by daily rate
GET {{endpoint}}/search?sort=dailyRate HTTP/1.1
x-api-key: blahblah

###
# Find available equipment for a rental period
GET {{endpoint}}/available?from=2026-10-10&to=2026-10-15 HTTP/1.1
x-api-key: blahblah

###
# Invalid availability dates
GET {{endpoint}}/available?from=2026-10-15&to=2026-10-10 HTTP/1.1
x-api-key: blahblah

###
# Invalid availability date format
GET {{endpoint}}/available?from=not-a-date&to=2026-10-15 HTTP/1.1
x-api-key: blahblah

###
# Search equipment with no filters
GET {{endpoint}}/search HTTP/1.1
x-api-key: blahblah

###
# Delete equipment
DELETE {{endpoint}}/{{newEquipment}} HTTP/1.1
content-type: application/json
x-api-key: blahblah