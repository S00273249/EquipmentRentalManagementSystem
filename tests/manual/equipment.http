content-type: application/json
x-api-key: blahblah

{
    "name": "Camera With Wrong Rate Type",
    "category": "Camera",
    "description": "Professional digital camera",
    "dailyRate": "50",
    "status": "Available",
    "condition": "Good"
}


###
# 3. Get all equipment
GET {{endpoint}} HTTP/1.1
x-api-key: blahblah


###
# 4. Get equipment by ID - successful GET
GET {{endpoint}}/{{newEquipment}} HTTP/1.1
x-api-key: blahblah


###
# 5. Get nonexistent equipment - failed GET
GET {{endpoint}}/000000000000000000000000 HTTP/1.1
x-api-key: blahblah


###
# 6. Delete equipment - successful DELETE
DELETE {{endpoint}}/{{newEquipment}} HTTP/1.1
x-api-key: blahblah


###
# 7. Delete nonexistent equipment - failed DELETE
DELETE {{endpoint}}/000000000000000000000000 HTTP/1.1
x-api-key: blahblah


###
# 8. Update existing equipment - valid PUT with all fields
PUT {{endpoint}}/{{existingEquipmentId}} HTTP/1.1
content-type: application/json
x-api-key: blahblah

{
    "name": "Updated Equipment Name",
    "category": "Camera",
    "description": "Updated equipment description",
    "dailyRate": 75,
    "status": "Available",
    "condition": "Excellent"
}


###
# Additional valid PUT - update name only
PUT {{endpoint}}/{{existingEquipmentId}} HTTP/1.1
content-type: application/json
x-api-key: blahblah

{
    "name": "Updated Equipment Name"
}


###
# Additional valid PUT - update daily rate only
PUT {{endpoint}}/{{existingEquipmentId}} HTTP/1.1
content-type: application/json
x-api-key: blahblah

{
    "dailyRate": 60
}


###
# 9. Update nonexistent equipment - failed PUT
PUT {{endpoint}}/000000000000000000000000 HTTP/1.1
content-type: application/json
x-api-key: blahblah

{
    "name": "Nonexistent Equipment"
}


###
# 10. Update equipment - invalid PUT with negative daily rate
PUT {{endpoint}}/{{existingEquipmentId}} HTTP/1.1
content-type: application/json
x-api-key: blahblah

{
    "dailyRate": -20
}


###
# Additional invalid PUT - empty name
PUT {{endpoint}}/{{existingEquipmentId}} HTTP/1.1
content-type: application/json
x-api-key: blahblah

{
    "name": ""
}


###
# Additional invalid PUT - daily rate has the wrong type
PUT {{endpoint}}/{{existingEquipmentId}} HTTP/1.1
content-type: application/json
x-api-key: blahblah

{
    "dailyRate": "60"
}


###
# 11. Filter equipment by category and status
GET {{endpoint}}/search?category=Camera&status=Available HTTP/1.1
x-api-key: blahblah


###
# Additional filter - category
GET {{endpoint}}/search?category=Camera HTTP/1.1
x-api-key: blahblah


###
# Additional filter - status
GET {{endpoint}}/search?status=Available HTTP/1.1
x-api-key: blahblah


###
# Additional filter - condition
GET {{endpoint}}/search?condition=Good HTTP/1.1
x-api-key: blahblah


###
# 12. Sort equipment by daily rate
GET {{endpoint}}/search?sort=dailyRate HTTP/1.1
x-api-key: blahblah


###
# Search equipment without filters
GET {{endpoint}}/search HTTP/1.1
x-api-key: blahblah


###
# 13. Find available equipment for a rental period
GET {{endpoint}}/available?from=2026-10-10&to=2026-10-15 HTTP/1.1
x-api-key: blahblah


###
# Invalid availability dates - end date before start date
GET {{endpoint}}/available?from=2026-10-15&to=2026-10-10 HTTP/1.1
x-api-key: blahblah


###
# Invalid availability dates - incorrect date format
GET {{endpoint}}/available?from=not-a-date&to=2026-10-15 HTTP/1.1
x-api-key: blahblah