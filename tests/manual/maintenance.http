@endpoint = http://localhost:3000/api/v1/maintenance

###
# Create equipment for maintenance tests
# @name postEquipment
POST http://localhost:3000/api/v1/equipment HTTP/1.1
content-type: application/json
x-api-key: blahblah

{
    "name": "Maintenance Test Equipment",
    "category": "Tool",
    "description": "Equipment used for maintenance tests",
    "dailyRate": 40,
    "status": "Available",
    "condition": "Good"
}

###
@equipmentId = {{postEquipment.response.body._id}}

###
# Create maintenance record
# @name postMaintenance
POST {{endpoint}} HTTP/1.1
content-type: application/json
x-api-key: blahblah

{
    "equipmentId": "{{equipmentId}}",
    "maintenanceType": "Repair",
    "description": "Replace damaged lens",
    "startDate": "2026-10-20",
    "endDate": "2026-10-22",
    "cost": 75,
    "notes": "Equipment unavailable during repair"
}

###
@newMaintenance = {{postMaintenance.response.body._id}}

###
# Get maintenance record by ID
GET {{endpoint}}/{{newMaintenance}} HTTP/1.1
content-type: application/json
x-api-key: blahblah

###
# Get all maintenance records
GET {{endpoint}} HTTP/1.1
content-type: application/json
x-api-key: blahblah

###
# Valid update - cost only
PUT {{endpoint}}/{{newMaintenance}} HTTP/1.1
content-type: application/json
x-api-key: blahblah

{
    "cost": 100
}

###
# Valid update - dates
PUT {{endpoint}}/{{newMaintenance}} HTTP/1.1
content-type: application/json
x-api-key: blahblah

{
    "startDate": "2026-10-21",
    "endDate": "2026-10-23"
}

###
# Invalid update - negative cost
PUT {{endpoint}}/{{newMaintenance}} HTTP/1.1
content-type: application/json
x-api-key: blahblah

{
    "cost": -20
}

###
# Invalid update - wrong cost type
PUT {{endpoint}}/{{newMaintenance}} HTTP/1.1
content-type: application/json
x-api-key: blahblah

{
    "cost": "100"
}

###
# Filter maintenance records by equipment
GET {{endpoint}}?equipmentId={{equipmentId}} HTTP/1.1
x-api-key: blahblah

###
# Delete maintenance record
DELETE {{endpoint}}/{{newMaintenance}} HTTP/1.1
content-type: application/json
x-api-key: blahblah